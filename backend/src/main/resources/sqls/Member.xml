<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="me.hellonayeon.backend.member.dao.MemberDao">

	<select id="findById"
	        parameterType="String"
	        resultType="me.hellonayeon.backend.member.domain.Member">

		SELECT
		id,
		name,
		pwd,
		email,
		role,
		enabled
		FROM member
		WHERE id = #{id}
		AND enabled = 'Y'

	</select>

<select id="isExistUserId" parameterType="String" resultType="java.lang.Integer">
	SELECT count(*)
	FROM member
	WHERE id=#{id}
</select>

	<insert id="createMember"
	        parameterType="me.hellonayeon.backend.member.dto.param.CreateMemberParam">

		INSERT INTO member(id, pwd, name, email)
		VALUES(#{id}, #{pwd}, #{name}, #{email})

	</insert>

	<select id="countMembers" resultType="java.lang.Integer">
		SELECT COUNT(*)
		FROM member
	</select>

	<select id="findMembers"
	        resultType="me.hellonayeon.backend.member.domain.Member">

		SELECT
		id,
		name,
		email,
		role,
		enabled
		FROM member
		WHERE enabled = 'Y'
		ORDER BY id ASC

	</select>

	<update id="changeRole">

		UPDATE member
		SET role = #{role}
		WHERE id = #{id}

	</update>

	<update id="deleteMember">

		UPDATE member
		SET enabled = 'N'
		WHERE id = #{id}

	</update>




